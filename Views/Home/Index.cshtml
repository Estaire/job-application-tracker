@{
    ViewData["Title"] = "Docket";
}

<div class="hero-layout">
    <div class="hero">
        <h1>Track every application, in one place.</h1>
        <p>No spreadsheets, no sticky notes. Log the roles you've applied to, follow your status from saved to offer, and keep the details you'll need before every interview.</p>

        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <a asp-controller="JobApplications" asp-action="Index" class="btn btn-primary">View My Applications</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Get Started</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-secondary">Log In</a>
        }
    </div>

    <div class="hiring-poster">
        <img src="~/images/hiring-poster.png" alt="We're hiring poster" class="poster-image" />
        <p id="hiring-role" class="poster-role-overlay">Backend Developer</p>
    </div>
</div>